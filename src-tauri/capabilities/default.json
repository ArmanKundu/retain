{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window, the capture bar and sticky notes",
  "windows": [
    "main",
    "capture",
    "sticky-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "notification:default",
    "dialog:default"
  ]
}
